# =============================================================================
# TREASURE HUNT BACKEND — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it contains secrets.
# =============================================================================

# --- Database (Supabase PostgreSQL) ---

# Transaction pooler (port 6543) — used by Express app at runtime
# Note: '?pgbouncer=true' is required to prevent prepared statement errors with PgBouncer
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — used by Prisma CLI for migrations
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Database (Local PostgreSQL — alternative for offline development) ---
# Uncomment and use these instead if you want to develop against your local database:
# DATABASE_URL="postgresql://postgres:[YOUR-LOCAL-PASSWORD]@localhost:5432/treasure_hunt?schema=public"
# DIRECT_URL="postgresql://postgres:[YOUR-LOCAL-PASSWORD]@localhost:5432/treasure_hunt?schema=public"

# --- Server ---
PORT=5000
